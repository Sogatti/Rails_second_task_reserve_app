<header>
  <nav>
<% if user_signed_in? %>
  <details class="header-dropdown">
    <summary class="header-user">
      <% if current_user.user_image.url.present? %>
        <%= image_tag current_user.user_image.url, class: "header_icon" %>
      <% else %>
        <%= image_tag "default-avatar-image.png", alt: "ヘッダーアイコン", class: "header_icon" %>
      <% end %>
      <span><%= current_user.name %></span>
    </summary>

    <ul class="header-menu">
      <li><%= link_to "予約一覧", reservations_path %></li>
      <li><%= link_to "登録済施設一覧", rooms_path %></li>
      <li><%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %></li>
      <li><%= link_to "アカウント", user_path %></li>
      <li><%= link_to "プロフィール", profile_user_path %></li>
    </ul>
  </details>
<% else %>
  <li><%= link_to "新規登録", new_user_registration_path %></li>
  <li><%= link_to "ログイン", new_user_session_path %></li>
<% end %>
  </nav>
</header>