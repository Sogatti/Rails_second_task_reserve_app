<section class="top-hero">
  <div class="top-hero-inner">
    <h1 class="top-title">Share hotelsで最高のホテル体験を！</h1>
    <p class="top-lead">Share hotelsは、ホテルの共有を通じて、最高のホテル体験を提供するサービスです。</p>

    <div class="top-search">
      <%= form_with url: search_rooms_path, method: :get, local: true, class: "search-form" do %>
        <div class="search-field">
          <%= label_tag :area, "エリア" %>
          <%= select_tag :area,
                options_for_select(
                  [["指定なし", ""], ["東京", "東京"], ["大阪", "大阪"], ["京都", "京都"], ["札幌", "札幌"]],
                  params[:area]
                ),
                class: "search-input" %>
        </div>

        <div class="search-field">
          <%= label_tag :keyword, "キーワード" %>
          <%= text_field_tag :keyword, params[:keyword],
                placeholder: "施設名・紹介文で検索",
                class: "search-input" %>
        </div>

        <%= submit_tag "検索する", class: "search-submit" %>
      <% end %>
    </div>
  </div>
</section>

<%# 4地域画像は別 section（おすすめのエリア）で後から追加 %>