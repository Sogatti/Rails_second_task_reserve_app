<h2>プロフィール</h2>

<table>
  <tr>
    <th>アイコン画像</th>
    <td>
    <% if @user.user_image.url.present? %>
      <%= image_tag @user.user_image.url, class: "user_image" %>
    <% else %>
      <%= image_tag "default-avatar-image.png", alt: "デフォルトアイコン", class: "user_image" %>
    <% end %>
    </td>
  </tr>

  <tr>
    <th>名前</th>
    <td><%= @user.name %></td>
  </tr>
  <tr>
    <th>自己紹介</th>
    <td><%= @user.introduction %></td>
  </tr>
</table>

<%= link_to "プロフィールを編集", edit_user_path %>