<h2>プロフィールを編集する</h2>

<%= form_with model: @user, url: user_path, method: :patch do |f| %>
  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field">
    <%= f.label :user_image, "アイコン画像" %>
    <% if @user.user_image.url.present? %>
      <%= image_tag @user.user_image.url, class: "user_image" %>
    <% else %>
      <%= image_tag "default-avatar-image.png", alt: "デフォルトアイコン", class: "user_image" %>
    <% end %>
    <%= f.file_field :user_image %>
  </div>

  <div class="field">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :introduction, "自己紹介" %>
    <%= f.text_area :introduction %>
  </div>

  <%= f.submit "保存" %>
<% end %>

<%= link_to "プロフィールページに戻る", profile_user_path %>